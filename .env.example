# All settings can be changed later from the dashboard. These are optional.

# Port the dashboard and webhooks listen on
PORT=3000

# Where data is stored (conversations, settings). Keep this folder backed up.
DATA_DIR=./data

# Recommended on a public server: required to create the first admin account.
SETUP_TOKEN=

# Claude API key (https://console.anthropic.com). Can also be set in the dashboard.
ANTHROPIC_API_KEY=

# First-boot AI defaults (optional)
# AI_PROVIDER=openai
# AI_MODEL=qwen3:8b
# AI_BASE_URL=http://ollama:11434/v1
# AI_API_KEY=

# Agency mode: run many businesses on one server. Console at /agency
# AGENCY_PASSWORD=

# Voice notes: any OpenAI-compatible speech-to-text API (Groq has a free tier)
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_MODEL=whisper-large-v3-turbo
# TRANSCRIBE_API_KEY=
